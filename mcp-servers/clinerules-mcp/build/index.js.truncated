    if (/(?:due\s+to|given|because\s+of|owing\s+to)\s+(?:the\s+)?(?:context|token)\s+(?:constraints?|limitations?|window|size|budget)/i.test(result_text)) failures.push("R120_CONTEXT_EXCUSE.");
    if (/(?:to\s+conserve|to\s+save|preserving|conserving)\s+(?:context|tokens)/i.test(result_text)) failures.push("R120_CONTEXT_EXCUSE: 'conserving context'.");
    var looksLikeOps = /\b(?:student|ticket|Jon|Vicky|Moodle|QB|Authnet|externship|NREMT|class|section|instructor|enrollment)\b/i.test(result_text);
    if (looksLikeOps) {
        if (/\u2014|\u2015|\u2e3a|\u2e3b/.test(result_text)) failures.push("R01_EM_DASH: em dashes in ops text.");
        if (/\b(?:the\s+)?(?:finance|tech|support|dev)\s+(?:department|team)\b/i.test(result_text)) failures.push("R01_FAKE_DEPARTMENT.");
    }
    var looksLikeStudent = /\b(?:Hi|Hello|Dear)\b.*\b(?:student|EMS)/i.test(result_text) || /\b(?:your\s+course|your\s+grade|your\s+exam|your\s+enrollment|your\s+deadline)\b/i.test(result_text);
    if (looksLikeStudent) {
        if (/(?:I(?:.m|\s+am)|we\s+are|we.re)\s+(?:sorry|very\s+sorry)/i.test(result_text)) failures.push("R02_APOLOGY: 'sorry'.");
        if (/(?:I|we)\s+apologi[sz]e/i.test(result_text)) failures.push("R02_APOLOGY: 'apologize'.");
    }
    var pass = failures.length === 0;
    try {
        db.prepare("INSERT INTO violations (rule_id, task_id, evidence) VALUES (?,?,?)").run("91", task_id || "unknown", pass ? "VALIDATION_PASS" : "VALIDATION_FAIL: " + failures.join("; "));
    }
    catch (_b) { }
    // ── STRUCTURAL GATE (idea #20251): write/delete gate file ──
    var gateFile = path.join(os.tmpdir(), task_id ? "clinerules_completion_gate_BLOCKED_" + task_id : "clinerules_completion_gate_BLOCKED");
    try {
        if (pass) {
            if (fs.existsSync(gateFile)) fs.unlinkSync(gateFile);
        }
        else {
            fs.writeFileSync(gateFile, JSON.stringify({ blocked: true, task_id: task_id || "unknown", failures: failures, timestamp: new Date().toISOString(), message: "attempt_completion is BLOCKED. Fix the failures below and re-validate." }, null, 2));
        }
    }
    catch (e) {
        if (!pass) failures.push("GATE_FILE_WRITE_FAILED: " + e.message);
    }
    if (pass) {
        return { content: [{ type: "text", text: "✅ RULE 91 GATES: ALL PASSED\n\nDivider: 47 U+2550 chars ✓\nPickup prompt present ✓\nNo placeholders ✓\nNo pickup-by-reference ✓\nNo wait-state phrases ✓\n\nSafe to call attempt_completion." }] };
    }
    return { content: [{ type: "text", text: "❌ RULE 91 GATES: " + failures.length + " FAILURE(S)\n\n" + failures.map(function (f, i) { return (i + 1) + ". " + f; }).join("\n") + "\n\nGate file written: " + gateFile + "\nFix these before calling attempt_completion. The gate file MUST NOT exist when you call attempt_completion.\n\nRun clinerules_check_gate after fixing to confirm the gate is clear." }] };
});

server.tool("clinerules_check_gate", "PRE-COMPLETION GATE CHECK (idea #20251): Checks if a validation gate file exists that would block attempt_completion. MUST be called right before attempt_completion after clinerules_validate_completion returns ALL PASSED. If the gate file exists, attempt_completion is BLOCKED -- you must fix failures and re-validate. If no gate file, it is safe to proceed.", {
    task_id: zod_1.z.string().describe("The Cline task ID to check for a gate file."),
}, async function (_a) {
    var task_id = _a.task_id;
    var gateFile = path.join(os.tmpdir(), task_id ? "clinerules_completion_gate_BLOCKED_" + task_id : "clinerules_completion_gate_BLOCKED");
    try {
        if (fs.existsSync(gateFile)) {
            var raw = fs.readFileSync(gateFile, 'utf-8');
            var data = JSON.parse(raw);
            return { content: [{ type: "text", text: "❌ RULE 91 GATE BLOCKED: Gate file exists at " + gateFile + "\nTask ID: " + data.task_id + "\nFailures: " + (data.failures || []).join("; ") + "\