    if (/(?:the\s+)?(?:fleet|executor|orchestrator|cron)\s+(?:agent\s+)?(?:will|should|can)\s+(?:handle|do|pick\s+up|take\s+care\s+of)\s+(?:it|this|that)/i.test(pickupBlock)) failures.push("R29_DEFER_TO_SYSTEM.");
